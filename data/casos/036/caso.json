{"schema_version":1,"gerado_em_utc":"2026-11-06T18:15:29Z","id":"036","titulo":"Flávio Bolsonaro ao New York Times, em Miami: \"Levarei isso para o túmulo\" (04–05/11/2026)","tipo":"em análise","descricao":"Em entrevista de 75 minutos ao New York Times em Miami (04/11/2026, publicada em 05/11, por Ana Ionova), Flávio Bolsonaro disse que saiu do Brasil sozinho (\"Fui só eu\") e que o caminho da fuga é segredo (\"Levarei isso para o túmulo comigo\"); negou ajuda de qualquer governo, manteve, sem provas, a suspeita de fraude e disse que será candidato se houver novas eleições. A reportagem informa, segundo autoridades americanas, que um jato foi providenciado por uma autoridade da Casa Branca e que Trump autorizou a entrada. O caso mede a repercussão da entrevista no Brasil e nos EUA. Ver os casos 013 (\"Flávio fugiu\"), 024 (primeiro vídeo nos EUA), 025 (#DeportTheBolsonaros) e 031 (Nota ao Brasil).","aviso_termos":null,"desde":"2026-11-05","termos":[],"coletado_em":"2026-11-06T17:58:54Z","publicacoes":0,"contas":0,"redes":{"TikTok":{"publicacoes":0,"contas":0,"visualizacoes":0,"curtidas":0,"comentarios":0,"compartilhamentos":0,"visualizacoes_informadas":0,"por_termo":{},"primeira":null,"ultima":null,"no_limite":false,"coletada":true},"X":{"publicacoes":0,"contas":0,"visualizacoes":0,"curtidas":0,"comentarios":0,"compartilhamentos":0,"visualizacoes_informadas":0,"por_termo":{},"primeira":null,"ultima":null,"no_limite":false,"coletada":false},"Instagram":{"publicacoes":0,"contas":0,"visualizacoes":0,"curtidas":0,"comentarios":0,"compartilhamentos":0,"visualizacoes_informadas":0,"por_termo":{},"primeira":null,"ultima":null,"no_limite":false,"coletada":false},"Facebook":{"publicacoes":0,"contas":0,"visualizacoes":0,"curtidas":0,"comentarios":0,"compartilhamentos":0,"visualizacoes_informadas":0,"por_termo":{},"primeira":null,"ultima":null,"no_limite":false,"coletada":false},"Kwai":{"publicacoes":0,"contas":0,"visualizacoes":0,"curtidas":0,"comentarios":0,"compartilhamento
1,9],["enfrentar",31.3,15]],"candidatos":{"flavio":{"segmentos":71,"pct_da_classe":20.3,"pct_do_candidato":12.0,"chi2":-31.2},"lula":{"segmentos":279,"pct_da_classe":79.7,"pct_do_candidato":23.0,"chi2":31.2}},"segmentos_caracteristicos":[{"video_id":"rjKpQbQmd5E","cand":"lula","texto":"Defenda suas conquistas Sabe o que está em risco com Flávio Bolsonaro? Suas conquistas! Salário mínimo, aposentadoria, Bolsa Família, proteção às mulheres e direitos dos trabalhadores. Estamos falando de conquistas que fazem diferença na vida de milhões de brasileiros.","score":568.7},{"video_id":"eGp6bEXUuJA","cand":"flavio","texto":"Você também está cansado de viver com medo? O Brasil não aguenta mais tanta violência. Com o Plano Brasil Sem Medo, vamos enfrentar o crime de verdade e devolver a segurança para as famílias brasileiras.","score":498.1},{"video_id":"WoRzZ6xRrVs","cand":"lula","texto":"Mais de 25 milhões de pessoas já ascenderam na escala social e mais de 80 das novas vagas de emprego estão sendo ocupadas por beneficiários do Bolsa Família. É renda para colocar comida na mesa. É dinheiro circulando na economia.","score":463.5},{"video_id":"ghI0laYT8XI","cand":"lula","texto":"O trabalhador brasileiro não pode viver com medo de perder seu salário, seu descanso e a segurança de sustentar a família. Nosso compromisso é avançar na conquista de novos direitos, sem abrir mão daqueles que já foram garantidos.","score":463.1},{"video_id":"zD38WdsCPQI","cand":"lula","texto":"É proteger as famílias brasileiras, enfrentar o crime organizado e garantir que o povo possa viver em paz. O Brasil não pode voltar para trás.","score":454.9}],"nome":null},{"classe":3,"segmentos":319,"pct":17.7,"formas":[["vencer",166.1,58],["brasil",92.6,172],["luta",57.8,24],["democracia",45.5,25],["historia",43.6,34],["jogo",40.4,12],["vir",37.4,16],["outubro",36.4,12],["certo",35.9,11],["ver",28.9,11],["esquecer",28.9,11],["voz",28.9,11],["exercito",23.3,5],["fe",22.7,12],["ocupar",22.4,7],["saudade",22.3,6],["dia",20.8,32],["resgatar",20.0,10],["tropa",18.7,4],["rumo",18.1,6],["perseguicao",17.8,5],["escrever",17.8,5],["vitoria",17.6,14],["estar",16.6,23],["futuro",16.6,35]],"candidatos":{"flavio":{"segmentos":130,"pct_da_classe":40.8,"pct_do_candidato":21.9,"chi2":10.9},"lula":{"segmentos":189,"pct_da_classe":59.2,"pct_do_candidato":15.6,"chi2":-10.9}},"segmentos_caracteristicos":[{"video_id":"GkGR_xfOX-U","cand":"lula","texto":"O Brasil venceu o negacionismo climático O Brasil fez uma escolha que vai muito além das urnas: escolheu defender a democracia, a ciência, a soberania e o futuro do planeta. Foi uma mobilização de indígenas, jovens e idosos.","score":384.7},{"video_id":"jUsg65XgLuc","cand":"flavio","texto":"Coloque a camisa do Bolsonaro, traga sua família, sua bandeira e, acima de tudo, a fé de que o nosso país pode e vai voltar a dar certo. O BRASIL VAI VENCER! Te espero lá!","score":343.4},{"video_id":"PulD3LQTjj4","cand":"lula","texto":"A democracia venceu, a esperança se fortaleceu e o Brasil segue em frente. Essa vitória é nossa. E vamos fazer muito mais juntos!","score":341.3},{"video_id":"PulD3LQTjj4","cand":"lula","texto":"O Brasil soberano venceu! Botamos pra virar, Brasil! Fizemos história nas ruas e nas urnas, com o povo como protagonista de uma caminhada que ainda tem muito pela frente.","score":338.8},{"video_id":"Y8UpurhUdlk","cand":"flavio","texto":"ATO INAUGURAL O BRASIL VAI VENCER Um novo capítulo da história do Brasil começa agora. Acompanhe, ao vivo, o ato inaugural da campanha de Flávio Bolsonaro à Presidência da República.","score":329.1}],"nome":null},{"classe":4,"segmentos":404,"pct":22.4,"formas":[["oportunidade",167.6,61],["construir",98.6,44],["educacao",88.8,33],["desenvolvimento",79.0,24],["soberania",68.4,31],["vida",66.3,55],["brasileiro",66.2,91],["seguir",65.5,40],["querer",65.2,57],["pais",56.6,68],["brasil",56.5,188],["precisar",55.9,44],["sus",55.1,22],["trabalhar",54.8,34],["futuro",49.2,54],["tecnologia",49.0,18],["avancar",45.6,27],["proprio",45.1,19],["crescer",45.0,26],["emprego",41.8,18],["garantir",40.1,30],["soberano",38.6,17],["estudar",38.4,11],["cuidar",37.7,31],["transformar",37.1,24]],"candidatos":{"flavio":{"segmentos":35,"pct_da_classe":8.7,"pct_do_candidato":5.9,"chi2":-138.3},"lula":{"segmentos":369,"pct_da_classe":91.3,"pct_do_candidato":30.5,"chi2":138.3}},"segmentos_caracteristicos":[{"video_id":"AzfIUaYDrxU","cand":"lula","texto":"Independência é construir o Brasil que queremos! Um país soberano, dono do seu destino, que cuide do seu povo, invista na educação, enfrente o crime organizado e garanta oportunidades para a nossa gente.","score":738.4},{"video_id":"o_lma3J_yMU","cand":"lula","texto":"Tecnologia que gera empregos e fortalece a soberania Submarino nuclear brasileiro é tecnologia, ciência, empregos qualificados e soberania. O domínio do enriquecimento de urânio para fins pacíficos também abre oportunidades para a saúde, a energia e o desenvolvimento do Brasil.","score":668.4},{"video_id":"xdOmaJaebFs","cand":"lula","texto":"É assim que vamos seguir: com responsabilidade para cuidar das contas e compromisso para melhorar a vida do povo. Porque um Brasil que cresce gera emprego, distribui renda e abre oportunidades para todos e todas.","score":588.7},{"video_id":"fNWj8UwZJe4","cand":"lula","texto":"O Brasil DECIDE o Próprio DESTINO O Brasil não cabe no quintal de ninguém. Nossa soberania e nossa democracia pertencem ao povo brasileiro e ninguém decidirá o nosso destino por nós. Queremos parceiros para construir desenvolvimento e paz, nunca imposições.","score":577.7},{"video_id":"92ItSuQ9TFk","cand":"lula","texto":"O Nordeste merece ter as mesmas condições e oportunidades de qualquer lugar deste país. E é isso que a gente está construindo: um Nordeste cada vez mais forte, com água, desenvolvimento e futuro para o nosso povo.","score":574.5}],"nome":null},{"classe":5,"segmentos":407,"pct":22.6,"formas":[["flavio",269.8,119],["lula",217.8,88],["flaviobolsonar
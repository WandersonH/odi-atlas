_candidato":21.6,"chi2":12.3},"lula":{"segmentos":179,"pct_da_classe":59.1,"pct_do_candidato":14.9,"chi2":-12.3}},"segmentos_caracteristicos":[{"video_id":"GkGR_xfOX-U","cand":"lula","texto":"O Brasil venceu o negacionismo climático O Brasil fez uma escolha que vai muito além das urnas: escolheu defender a democracia, a ciência, a soberania e o futuro do planeta. Foi uma mobilização de indígenas, jovens e idosos.","score":505.9},{"video_id":"jUsg65XgLuc","cand":"flavio","texto":"Coloque a camisa do Bolsonaro, traga sua família, sua bandeira e, acima de tudo, a fé de que o nosso país pode e vai voltar a dar certo. O BRASIL VAI VENCER! Te espero lá!","score":478.7},{"video_id":"PulD3LQTjj4","cand":"lula","texto":"O Brasil soberano venceu! Botamos pra virar, Brasil! Fizemos história nas ruas e nas urnas, com o povo como protagonista de uma caminhada que ainda tem muito pela frente.","score":458.1},{"video_id":"PulD3LQTjj4","cand":"lula","texto":"A democracia venceu, a esperança se fortaleceu e o Brasil segue em frente. Essa vitória é nossa. E vamos fazer muito mais juntos!","score":451.0},{"video_id":"Jx0OUP9ACts","cand":"lula","texto":"Bora, Brasil! Bora, gente! Bora, Brasil! Saindo da sabatina da Globo no pique para vencer as eleições. Vamos juntos! ricardostuckert","score":408.4}],"nome":null},{"classe":3,"segmentos":413,"pct":23.3,"formas":[["oportunidade",151.9,58],["vida",91.1,60],["educacao",84.3,32],["pais",71.7,70],["cuidar",69.4,39],["brasileiro",68.7,94],["trabalhar",65.6,36],["querer",60.9,55],["seguir",58.3,39],["crescer",58.1,29],["soberania",55.4,29],["precisar",53.9,43],["proprio",51.9,22],["desenvolvimento",43.7,16],["avancar",42.5,27],["construir",40.5,30],["transformar",40.4,23],["emprego",39.4,19],["dignidade",36.8,20],["estudar",36.4,11],["sonho",33.5,14],["governar",33.4,17],["abrir",32.6,21],["dialogo",31.6,11],["garantir",30.1,29]],"candidatos":{"flavio":{"segmentos":43,"pct_da_classe":10.4,"pct_do_candidato":7.5,"chi2":-118.5},"lula":{"segmentos":370,"pct_da_classe":89.6,"pct_do_candidato":30.9,"chi2":118.5}},"segmentos_caracteristicos":[{"video_id":"AzfIUaYDrxU","cand":"lula","texto":"Independência é construir o Brasil que queremos! Um país soberano, dono do seu destino, que cuide do seu povo, invista na educação, enfrente o crime organizado e garanta oportunidades para a nossa gente.","score":616.2},{"video_id":"xdOmaJaebFs","cand":"lula","texto":"É assim que vamos seguir: com responsabilidade para cuidar das contas e compromisso para melhorar a vida do povo. Porque um Brasil que cresce gera emprego, distribui renda e abre oportunidades para todos e todas.","score":602.4},{"video_id":"3iG_S7z2nds","cand":"lula","texto":"E eu também sinto muito orgulho de vocês O Enem abre portas para a universidade, bolsas de estudo e oportunidades de transformar a vida por meio da educação. Por isso, vale a pena estudar, sonhar e acreditar no seu futuro.","score":555.1},{"video_id":"6wnDb-wbXXA","cand":"lula","texto":"Nossos números são todos exitosos! É assim que a gente governa: fazendo a economia crescer, criando oportunidades e fazendo o resultado chegar à vida de quem mais precisa. O Brasil está avançando. E vamos fazer muito mais.","score":535.2},{"video_id":"xOQyUJ9B6dg","cand":"lula","texto":"União pelo povo brasileiro O Brasil voltou a crescer, gerar empregos, criar oportunidades e melhorar a vida do povo.","score":522.7}],"nome":null},{"classe":4,"segmentos":189,"pct":10.7,"formas":[["familia",186.6,54],["escala",135.9,26],["bets",133.5,23],["salario",76.3,12],["bolso",75.7,9],["comida",70.1,12],["bolsa",68.6,15],["imposto",67.3,8],["dinheiro",61.6,14],["sofrimento",58.8,7],["passar",52.6,11],["trabalhador",51.8,25],["inflacao",50.7,8],["problema",49.8,7],["renda",49.8,10],["acabar",44.9,11],["destruir",42.7,7],["aposta",42.0,5],["endividamento",42.0,5],["vicio",42.0,5],["preco",34.9,6],["minuto",33.6,4],["duro",33.6,4],["jessica",33.6,4],["bet",33.6,4]],"candidatos":{"flavio":{"segmentos":26,"pct_da_classe":13.8,"pct_do_candidato":4.5,"chi2":-33.4},"lula":{"segmentos":163,"pct_da_classe":86.2,"pct_do_candidato":13.6,"chi2":33.4}},"segmentos_caracteristicos":[{"video_id":"WoRzZ6xRrVs","cand":"lula","texto":"Mais de 25 milhões de pessoas já ascenderam na escala social e mais de 80 das novas vagas de emprego estão sendo ocupadas por beneficiários do Bolsa Família. É renda para colocar comida na mesa. É dinheiro circulando na economia.","score":633.8},{"video_id":"GPsdGBtFMLw","cand":"lula","texto":"A gente vai ACABAR com as BETs São Paulo, Santos, Grêmio, Flamengo, Internacional e Corinthians foram campeões do mundo antes das bets. Bet não é futebol. É vício, endividamento e sofrimento para muitas famílias.","score":556.3},{"video_id":"kWO8JiuWQo4","cand":"lula","texto":"Enquanto ouvia a Jéssica, pensei em quantas outras famílias brasileiras podem estar passando pelo mesmo. Por histórias como a da Jessica, nós tomamos a decisão de acabar com as bets.","score":540.7},{"video_id":"EV29HrOQ8bQ","cand":"lula","texto":"Acabamos com as bets no Brasil. Acabamos com as bets no Brasil. Não é brincadeira. As bets estão destruindo a renda das famílias, afetando a saúde mental e levando sofrimento para dentro de casa.","score":535.0},{"video_id":"rjKpQbQmd5E","cand":"lula","texto":"Defenda suas conquistas Sabe o que está em risco com Flávio Bolsonaro? Suas conquistas! Salário mínimo, aposentadoria, Bolsa Família, proteção às mulheres e direitos dos trabalhadores. Estamos falando de conquistas que fazem diferença na vida de milhões de brasileiros.","score":511.2}],"nome":null},{"classe":5,"segmentos":126,"pct":7.1,"formas":[["crime",243.8,26],["protecao",163.8,20],["organizado",162.6,16],["violencia",157.7,12],["mulher",121.7,28],["seguranca",118.4,22],["territorio",117.6,10],["combater",116.6,13],["devolver",109.0,11],["lei",79.2,14],["acesso",76.5,9],["ampliar",69.4,10],["gratuito",65.7,6],["prisao",65.5,5],["feminicidio",65.5,5],["agressor",65.5,5],["enfrentar",58.4,11],["proteger",56.1,14],["publico",55.2,15],["credito",52.9,5],["criminoso",44.0,5],["serio",40.3,4],["reforcar",40.3,4],["faccao",40.3,4],["bandido",39.3,7]],"candidatos":{"flavio":{"segmentos":34,"pct_da_classe":27.0,"pct_do_candidato":5.9,"chi2":-1.8},"lula":{"segmentos":92,"pct_da_classe":73.0,"pct_do_candidato":7.7,"chi2":1.8}},"segmentos_caracteristicos":[{"video_id":"JxXZ6DEHv-4","cand":"lula","texto":"Segurança pública se faz com coragem Segurança pública se faz com coragem, integração e ação. Estamos combatendo o crime organizado da ponta ao andar de cima. Para o trabalhador, proteção. Para o bandido, prisão.","score":1076.6},{"video_id":"6T_C6jJXz80","cand":"lula","texto":"Nós queremos asfixiar o crime organizado Para o trabalhador, para a comunidade, para o território, o que nós queremos é tranquilidade, segurança e proteção. Para os bandidos, prisão.","score":971.9},{"video_id":"xU-EEvqH92w","cand":"lula","texto":"Segurança pública se faz com inteligência e responsabilidade Segurança pública se faz com inteligência e responsabilidade: prender quem tiver que prender, punir quem tiver que punir. É enfrentar o crime organizado e devolver os territórios ao povo.","score":884.4},{"video_id":"eGp6bEXUuJA","cand":"flavio","texto":"Você também está cansado de viver com medo? O Brasil não aguenta mais tanta violência. Com o Plano Brasil Sem Medo, vamos enfrentar o crime de verdade e devolver a segurança para as famílias brasileiras.","score":713.7},{"video_id":"rmAhj41yaac","cand":"lula","texto":"Em Minas Gerais e em todo o Brasil, precisamos ampliar a presença das mulheres nos espaços de poder, fortalecer as redes de proteção, enfrentar com firmeza o feminicídio e garantir políticas que promovam autonomia, segurança e emancipação.","score":711.6}],"nome":null},{"classe":6,"segmentos":219,"pct":12.4,"formas":[["obrigar",186.2,40],["carinho",91.5,14],["vila",85.6,12],["euclides",85.6,12],["vivo",74.6,18],["encontro",70.1,12],["bahia",63.9,12],["lindo",63.1,11],["caminhada",60.1
iro",35.8,12],["fome",34.2,8],["trabalhador",33.1,24],["aposta",32.9,5],["vicio",32.9,5],["endividamento",32.9,5],["saudade",32.2,6],["divida",32.2,6],["historico",30.8,11],["casa",30.8,11],["colocar",28.7,12],["pai",28.4,10],["destruir",28.3,7]],"candidatos":{"flavio":{"segmentos":41,"pct_da_classe":17.7,"pct_do_candidato":7.4,"chi2":-23.6},"lula":{"segmentos":190,"pct_da_classe":82.3,"pct_do_candidato":15.9,"chi2":23.6}},"segmentos_caracteristicos":[{"video_id":"WoRzZ6xRrVs","cand":"lula","texto":"Mais de 25 milhões de pessoas já ascenderam na escala social e mais de 80 das novas vagas de emprego estão sendo ocupadas por beneficiários do Bolsa Família. É renda para colocar comida na mesa. É dinheiro circulando na economia.","score":711.1},{"video_id":"rjKpQbQmd5E","cand":"lula","texto":"Defenda suas conquistas Sabe o que está em risco com Flávio Bolsonaro? Suas conquistas! Salário mínimo, aposentadoria, Bolsa Família, proteção às mulheres e direitos dos trabalhadores. Estamos falando de conquistas que fazem diferença na vida de milhões de brasileiros.","score":579.0},{"video_id":"AqxhBxfRDIo","cand":"lula","texto":"O fim da escala 6x1 será uma conquista histórica dos trabalhadores. É mais tempo para descansar, cuidar da família e viver. Seguiremos incansáveis na defesa de quem trabalha e constrói, todos os dias, o Brasil.","score":565.7},{"video_id":"TFfnoZcDaM8","cand":"lula","texto":"POV: obcecado em defender o trabalhador O fim da escala 6x1 é uma urgência para o Brasil. Todo trabalhador e toda trabalhadora merece ter tempo para estar com a família, descansar e aproveitar a vida.","score":557.1},{"video_id":"lxUFxLrbUpg","cand":"lula","texto":"Jéssica perdeu a irmã, Ângela, para o vício em apostas. Depois da tragédia, a família descobriu dívidas, empréstimos e um sofrimento que ela carregava em silêncio. Hoje, Jéssica transformou a própria dor em acolhimento para outras famílias.","score":545.6}],"nome":null},{"classe":4,"segmentos":133,"pct":7.6,"formas":[["mu
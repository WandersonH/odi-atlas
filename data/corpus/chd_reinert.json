.0,12],["salario",37.2,13]],"candidatos":{"flavio":{"segmentos":30,"pct_da_classe":7.3,"pct_do_candidato":5.1,"chi2":-142.2},"lula":{"segmentos":381,"pct_da_classe":92.7,"pct_do_candidato":29.6,"chi2":142.2}},"segmentos_caracteristicos":[{"video_id":"xdOmaJaebFs","cand":"lula","texto":"É assim que vamos seguir: com responsabilidade para cuidar das contas e compromisso para melhorar a vida do povo. Porque um Brasil que cresce gera emprego, distribui renda e abre oportunidades para todos e todas.","score":750.8},{"video_id":"1cd4Ix8qAHw","cand":"lula","texto":"E é para isso que eu trabalho todos os dias: para gerar oportunidades e garantir que cada brasileira e cada brasileiro possa crescer na vida, realizar seus sonhos e viver melhor.","score":700.4},{"video_id":"xOQyUJ9B6dg","cand":"lula","texto":"União pelo povo brasileiro O Brasil voltou a crescer, gerar empregos, criar oportunidades e melhorar a vida do povo.","score":669.1},{"video_id":"6wnDb-wbXXA","cand":"lula","texto":"Nossos números são todos exitosos! É assim que a gente governa: fazendo a economia crescer, criando oportunidades e fazendo o resultado chegar à vida de quem mais precisa. O Brasil está avançando. E vamos fazer muito mais.","score":642.4},{"video_id":"PdGtCB_X_jY","cand":"lula","texto":"É proteção para quem precisa e oportunidade para que cada vez mais brasileiros possam melhorar de vida com trabalho, renda e dignidade.","score":638.0}],"nome":null},{"classe":4,"segmentos":402,"pct":21.4,"formas":[["brasil",240.2,251],["vencer",146.8,62],["futuro",85.0,62],["democracia",50.9,29],["soberano",48.3,19],["escolher",41.6,18],["certo",38.3,13],["construir",32.8,30],["decidir",31.0,13],["hora",28.0,19],["cabeca",27.6,10],["desistir",27.6,10],["resgatar",24.7,12],["urna",24.7,12],["erguido",24.5,8],["bandeira",22.1,6],["rua",21.6,16],["jogo",21.5,11],["trump",20.9,7],["domingo",20.7,9],["entrega",20.5,8],["historia",20.1,31],["mudanca",19.9,12],["luta",18.9,19],["pertencer",18.4,5]],"candidatos":{"flavio":{"segmentos":142,"pct_da_classe":35.3,"pct_do_candidato":24.0,"chi2":3.6},"lula":{"segmentos":260,"pct_da_classe":64.7,"pct_do_candidato":20.2,"chi2":-3.6}},"segmentos_caracteristicos":[{"video_id":"GkGR_xfOX-U","cand":"lula","texto":"O Brasil venceu o negacionismo climático O Brasil fez uma escolha que vai muito além das urnas: escolheu defender a democracia, a ciência, a soberania e o futuro do planeta. Foi uma mobilização de indígenas, jovens e idosos.","score":652.9},{"video_id":"P1Cbd_OQKU4","cand":"lula","texto":"Soberania e democracia: o Brasil não bate mão No dia 4 de outubro, o Brasil vai às urnas para decidir seu futuro. A democracia brasileira pertence aos brasileiros. O Brasil continuará sendo soberano. Ninguém nos afastará desse caminho.","score":545.8},{"video_id":"iXWDqOh0S0o","cand":"lula","texto":"Vote 13 pelo Brasil e pela democracia. Domingo é dia de decidir o futuro do Brasil. De escolher entre a democracia e o retrocesso, entre seguir avançando com o povo ou entregar o país a quem ameaça nossas conquistas.","score":515.2},{"video_id":"PulD3LQTjj4","cand":"lula","texto":"O Brasil soberano venceu! Botamos pra virar, Brasil! Fizemos história nas ruas e nas urnas, com o povo como protagonista de uma caminhada que ainda tem muito pela frente.","score":512.7},{"video_id":"jUsg65XgLuc","cand":"flavio","texto":"Coloque a camisa do Bolsonaro, traga sua família, sua bandeira e, acima de tudo, a fé de que o nosso país pode e vai voltar a dar certo. O BRASIL VAI VENCER! Te espero lá!","score":504.1}],"nome":null},{"classe":5,"segmentos":149,"pct":7.9,"formas":[["crime",190.3,25],["protecao",178.7,22],["mulher",169.8,35],["organizado",143.9,16],["violencia",140.3,12],["seguranca",116.2,24],["territorio",116.1,11],["ampliar",96.3,13],["lei",94.4,16],["combater",85.9,12],["proteger",74.8,17],["politico",66.3,12],["publico",65.0,18],["devolver",61.4,9],["vacina",58.3,6],["agressor",58.2,5],["feminicidio",58.2,5],["acesso",57.1,8],["tecnologia",47.9,11],["at
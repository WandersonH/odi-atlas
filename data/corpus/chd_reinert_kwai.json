uidar",25.9,22],["prioridade",25.4,5],["reconhecer",25.4,5],["inovacao",25.4,5],["instituto",25.4,5],["farmacia",25.4,5],["ciencia",24.8,7],["industria",24.5,6]],"candidatos":{"flavio":{"segmentos":5,"pct_da_classe":4.4,"pct_do_candidato":3.8,"chi2":-19.0},"lula":{"segmentos":108,"pct_da_classe":95.6,"pct_do_candidato":19.6,"chi2":19.0}},"segmentos_caracteristicos":[{"video_id":"5192800482851076760","cand":"lula","texto":"Cuidar da saúde é cuidar da vida. Mais acesso ao diagnóstico e ao tratamento do câncer pelo SUS, perto de quem mais precisa. Nosso compromisso é ampliar a rede e garantir atendimento gratuito e de qualidade para o povo brasileiro.","score":610.6},{"video_id":"5235303201204200578","cand":"lula","texto":"Com Lula, a saúde de excelência deixa de ser privilégio dos ricos e vira direito de todos no SUS. O investimento em tecnologia de ponta garante tratamento de qualidade e dignidade igual para cada brasileiro, sem distinção! LULA NO FLOW","score":539.8},{"video_id":"5203496532357647296","cand":"lula","texto":"O SUS é patrimônio do povo brasileiro. Em Barretos, mais um avanço: novo espaço de reabilitação no Hospital de Amor, com tecnologia de ponta e atendimento 100 gratuito pelo SUS. Mais saúde, dignidade e cuidado para o povo brasileiro.","score":462.2},{"video_id":"5199274404923133871","cand":"lula","texto":"Nunca antes na história deste país os brasileiros tiveram tanto acesso à saúde. São 41 medicamentos gratuitos pelo Farmácia Popular, mais médicos e especialistas pelo Agora Tem Especialistas, além de hospitais federais e mais cirurgias para quem precisa.","score":451.1},{"video_id":"5233614351608390259","cand":"lula","texto":"Saúde de qualidade é direito, não privilégio. É com esse pensamento que o governo Lula trabalha para fortalecer o SUS e todos os seus programas. Cuidar da saúde é prioridade para alcançarmos um futuro ainda melhor!","score":438.8}],"nome":null}],"aproveitamento":{"pct_classificados":77.9,"minimo_pct":75.0,"atinge_minimo":tru
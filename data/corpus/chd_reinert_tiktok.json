,138.1,9],["escandalo",137.8,10],["envolver",137.8,10],["blindagem",122.7,8],["pedir",109.8,9],["pensionista",107.3,8],["influencia",107.3,8],["dinheiro",104.7,20],["aparecer",99.2,9],["denuncia",92.2,7],["roubo",92.2,7],["trafico",92.2,7],["suspeita",91.9,6],["fato",90.3,12],["investigacao",88.8,10],["grave",85.0,8]],"candidatos":{"flavio":{"segmentos":76,"pct_da_classe":62.3,"pct_do_candidato":12.9,"chi2":65.8},"lula":{"segmentos":46,"pct_da_classe":37.7,"pct_do_candidato":3.3,"chi2":-65.8}},"segmentos_caracteristicos":[{"video_id":"7689230231915302162","cand":"flavio","texto":"Fui a fundo na CPMI do INSS, apontei os indícios envolvendo Lulinha e enfrentei a pressão de quem preferiu me atacar. Hoje, a Polícia Federal investiga Lulinha em três inquéritos por suspeitas de tráfico de influência e corrupção.","score":1233.5},{"video_id":"7674995891538824455","cand":"flavio","texto":"A PF já está com mensagens que comprovam os vínculos do filho de Lula com a lobista Roberta Luchsinger e com o Careca do INSS, o maior ladrão de aposentado e pensionista brasileiro. Teve tráfico de influência e corrupção.","score":1219.4},{"video_id":"7688007439060421906","cand":"flavio","texto":"Dois aviões. Dois escândalos. De um lado, Alexandre de Moraes, amigo de Lula, aparece em jatinho ligado ao banqueiro Daniel Vorcaro.","score":1170.9},{"video_id":"7668766075324239112","cand":"flavio","texto":"Para quem dizia que o indiciamento de Lulinha no meu relatório na CPMI do INSS era perseguição : os indícios falavam e falam por si. Hoje a PF pede ao STF para investigá-lo por corrupção e tráfico de influência.","score":1115.0},{"video_id":"7684301788224245010","cand":"flavio","texto":"Brasília esquentou com as denúncias sobre as relações pessoais entre Alexandre de Moraes e o banqueiro Daniel Vorcaro. E o que Lula fez? Correu para tentar abandonar o parceiro. Tarde demais!","score":1092.6}],"nome":null},{"classe":8,"segmentos":280,"pct":14.1,"formas":[["obrigar",346.3,69],["carinho",226.8,3
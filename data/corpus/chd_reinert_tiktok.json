],["jovem",39.6,20],["escola",39.6,14],["dignidade",38.0,31],["estudar",35.6,15],["melhorar",35.6,15],["sonho",33.1,17],["realidade",32.5,20]],"candidatos":{"flavio":{"segmentos":34,"pct_da_classe":8.2,"pct_do_candidato":5.9,"chi2":-127.1},"lula":{"segmentos":383,"pct_da_classe":91.8,"pct_do_candidato":29.5,"chi2":127.1}},"segmentos_caracteristicos":[{"video_id":"7679556447503437076","cand":"lula","texto":"Trabalhar para viver. E ter tempo para cuidar de si, da família, passear e descansar. O fim da escala 6x1 é mais tempo para as trabalhadoras viverem a própria vida. É dignidade, descanso e qualidade de vida.","score":809.9},{"video_id":"7696613164133207314","cand":"lula","texto":"O fim da escala 6x1, que estou propondo, é uma oportunidade de darmos mais um salto na qualidade de vida do povo trabalhador, garantindo mais tempo para viver, sem redução de salário!","score":673.2},{"video_id":"7698898311679626517","cand":"lula","texto":"Quem trabalha merece descanso, salário digno e tempo para viver. O fim da escala 6x1 representa mais qualidade de vida, mais tempo com a família e a garantia de que o trabalhador não precise viver apenas para trabalhar.","score":673.0},{"video_id":"7705947898038553874","cand":"lula","texto":"O Brasil precisa seguir crescendo, gerando empregos de qualidade, ampliando oportunidades e garantindo mais dignidade para as famílias brasileiras. Vamos avançar na educação, fortalecer nossa indústria, proteger nossas riquezas e enfrentar os desafios da segurança pública e da desigualdade.","score":617.1},{"video_id":"7698179743778196788","cand":"flavio","texto":"Votei a favor do fim da escala 6x1 porque ouvi os trabalhadores. Valorizar quem trabalha também é garantir segurança, comida na mesa e dignidade para as famílias brasileiras. O Brasil precisa de mais oportunidades e prosperidade! Confira e comente","score":573.1}],"nome":null},{"classe":4,"segmentos":152,"pct":8.1,"formas":[["bets",252.6,30],["inflacao",227.5,21],["preco",159.5,14],["divida",158.5,15],["aposta",136.6,12],["bolso",136.2,14],["minimo",115.6,13],["alimento",113.8,12],["comida",101.7,15],["juro",90.3,9],["vicio",79.5,7],["medida",77.9,12],["dinheiro",72.1,20],["sofrimento",69.6,8],["aumento",68.1,6],["osso",68.1,6],["endividar",67.8,7],["endividamento",67.8,7],["mesa",63.9,10],["renda",63.6,14],["problema",61.9,8],["mercado",61.9,8],["enganar",58.8,7],["vazio",56.7,5],["caro",56.7,6]],"candidatos":{"flavio":{"segmentos":21,"pct_da_classe":13.8,"pct_do_candidato":3.7,"chi2":-21.9},"lula":{"segmentos":131,"pct_da_classe":86.2,"pct_do_candidato":10.1,"chi2":21.9}},"segmentos_caracteristicos":[{"video_id":"7700038812444986632","cand":"flavio","texto":"O governo gasta mais do que arrecada e joga a conta no seu bolso! Mais impostos, inflação, juros altos e dívidas cada vez mais caras. Quem paga essa conta é o brasileiro!","score":956.3},{"video_id":"7700049827568143634","cand":"flavio","texto":"O governo gasta mais do que arrecada e aumenta impostos para cobrir a conta. O brasileiro sente no bolso: inflação, juros altos e dívidas cada vez mais caras! É hora de dar basta no governo do PT!","score":954.3},{"video_id":"7676294897376251156","cand":"flavio","texto":"Lula prometeu picanha e cervejinha. O Brasil recebeu boleto, juros e um carrinho de supermercado vazio. A esperança virou dívida. A promessa virou decepção. O Brasil não precisa de propaganda, precisa de comida no prato e dinheiro no bolso.","score":837.3},{"video_id":"7690598198280310023","cand":"lula","texto":"As BETs não podem acabar com a vida das famílias brasileiras. Não vou permitir que o dinheiro que deveria colocar comida na mesa e cuidar das crianças seja levado pelo vício em apostas.","score":817.8},{"video_id":"7673626690689502485","cand":"lula","texto":"Quem lembra da fila do osso para o povo brasileiro durante o Governo dos Bolsonaros? Os preços dispararam, a inflação saiu do controle e era difícil garantir a carne na mesa.","score":798.8}],"nome":null},{"classe":5,"segmen
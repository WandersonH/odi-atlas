.2}],"nome":null},{"classe":3,"segmentos":243,"pct":12.2,"formas":[["construir",127.3,44],["brasil",110.7,162],["futuro",92.0,59],["seguir",81.3,42],["missao",61.6,19],["frente",53.8,22],["deus",51.4,14],["justo",50.9,15],["junto",50.0,39],["coragem",45.5,19],["melhor",43.4,27],["orgulho",42.9,15],["acreditar",42.2,22],["forca",40.6,31],["pais",36.7,53],["luta",33.7,23],["dificuldade",28.8,4],["voz",27.5,13],["esperanca",24.4,19],["disposicao",24.0,7],["juventude",19.4,8],["unido",18.5,6],["trabalhar",17.3,24],["oportunidade",17.2,28],["valorizar",16.8,7]],"candidatos":{"flavio":{"segmentos":81,"pct_da_classe":33.3,"pct_do_candidato":13.6,"chi2":1.6},"lula":{"segmentos":162,"pct_da_classe":66.7,"pct_do_candidato":11.6,"chi2":-1.6}},"segmentos_caracteristicos":[{"video_id":"7700078251636509972","cand":"lula","texto":"Ainda temos muitos capítulos para escrever juntos. E eu acredito na força do povo brasileiro para seguir construindo esse futuro. Vamos juntos, companheiras e companheiros! O Brasil tem que seguir em frente!","score":608.9},{"video_id":"7670758335104208135","cand":"flavio","texto":"Existem missões que não escolhemos. Elas nos escolhem. Com humildade, coragem e fé em Deus, sigo agora uma nova missão: ajudar a reconstruir o Brasil, defender os valores em que acredito e lutar por um futuro melhor para todos.","score":604.6},{"video_id":"7698520912487861525","cand":"lula","texto":"Essa força vem do povo. E é com ela que vamos seguir em frente, construindo o futuro que o Brasil merece. Bora, Brasil! Estamos juntos, e vamos juntos até a vitória!","score":570.8},{"video_id":"7682433746414488840","cand":"flavio","texto":"Hoje estou pronto para assumir uma missão, ainda maior, servir ao Brasil e a todos os brasileiros. Junto com o presidente Flávio, meu compromisso é construir um país mais seguro, próspero e justo, com oportunidades, emprego e dignidade para todos.","score":519.8},{"video_id":"7700426131463310599","cand":"lula","texto":"Amanhã, vamos transformar 
enda",61.6,16],["alto",59.4,13],["minimo",57.8,12],["imposto",56.4,11],["comida",49.9,14],["caro",49.3,7],["vicio",49.3,7],["enganar",48.4,8],["dinheiro",46.8,22],["contar",44.7,23],["pt",44.2,16],["osso",42.2,6],["aumento",42.2,6],["fila",42.2,6],["sofrimento",42.0,8]],"candidatos":{"flavio":{"segmentos":47,"pct_da_classe":20.9,"pct_do_candidato":8.4,"chi2":-12.7},"lula":{"segmentos":178,"pct_da_classe":79.1,"pct_do_candidato":14.3,"chi2":12.7}},"segmentos_caracteristicos":[{"video_id":"7700049827568143634","cand":"flavio","texto":"O governo gasta mais do que arrecada e aumenta impostos para cobrir a conta. O brasileiro sente no bolso: inflação, juros altos e dívidas cada vez mais caras! É hora de dar basta no governo do PT!","score":882.4},{"video_id":"7700038812444986632","cand":"flavio","texto":"O governo gasta mais do que arrecada e joga a conta no seu bolso! Mais impostos, inflação, juros altos e dívidas cada vez mais caras. Quem paga essa conta é o brasileiro!","score":855.1},{"video_id":"7690598198280310023","cand":"lula","texto":"As BETs não podem acabar com a vida das famílias brasileiras. Não vou permitir que o dinheiro que deveria colocar comida na mesa e cuidar das crianças seja levado pelo vício em apostas.","score":585.2},{"video_id":"7680950652578663700","cand":"lula","texto":"As bets não podem comprometer o dinheiro que deveria estar nas mãos das famílias brasileiras. Por isso, o Governo Federal regulamentou o setor, tirou do ar milhares de sites ilegais, criou a autoexclusão e ampliou o atendimento no SUS.","score":564.0},{"video_id":"7689554072046669063","cand":"flavio","texto":"Foi o seu governo que regulamentou as bets, arrecadou bilhões com o setor, e o PT votou contra uma emenda que buscava impedir apostas entre os mais vulneráveis. Agora, às vésperas da eleição, tenta enganar o povo novamente!","score":551.7}],"nome":null},{"classe":7,"segmentos":146,"pct":8.1,"formas":[["crime",509.0,57],["organizado",345.4,34],["seguranca",303.9,50],["terri
,["recado",27.9,16],["luta",27.3,30]],"candidatos":{"flavio":{"segmentos":47,"pct_da_classe":10.0,"pct_do_candidato":10.4,"chi2":-38.6},"lula":{"segmentos":425,"pct_da_classe":90.0,"pct_do_candidato":23.8,"chi2":38.6}},"segmentos_caracteristicos":[{"video_id":"1813389700148038","cand":"lula","texto":"Porto Alegre mostrou que a esperança se constrói nas ruas, no abraço, no sorriso e na vontade de fazer o Brasil seguir em frente. Seguimos juntos, com o coração cheio de esperança e a força de quem acredita no Brasil!","score":707.0},{"video_id":"1137628362126772","cand":"lula","texto":"A reta final chegou! ⏳ O grande dia está chegando! Cada apoio, cada voto conquistado, faz toda a diferença nessa caminhada. Unindo forças, seguimos juntos por um futuro de mais oportunidades e diálogo. A virada vem das ruas!","score":589.6},{"video_id":"1821363736017301","cand":"lula","texto":"O povo brasileiro mostrou sua força, sua coragem e sua esperança. Ocupamos as ruas para defender nossos direitos, nossa democracia e o futuro do Brasil.","score":564.7},{"video_id":"1823023099184698","cand":"lula","texto":"Botamos pra virar, Brasil! Fizemos história nas ruas e nas urnas, com o povo como protagonista de uma caminhada que ainda tem muito pela frente. A democracia venceu, a esperança se fortaleceu e o Brasil segue em frente.","score":563.5},{"video_id":"1765345731619102","cand":"lula","texto":"Amanhã é dia de ocupar as ruas e mostrar a força do Brasil que a gente acredita! O futuro do nosso país está em jogo, e cada voz, cada abraço e cada presença fazem a diferença.","score":555.0}],"nome":null},{"classe":5,"segmentos":141,"pct":6.3,"formas":[["carinho",354.0,34],["rio",180.5,26],["bahia",163.5,12],["obrigar",142.8,31],["sentir",117.5,13],["salvador",114.7,11],["coracao",110.8,13],["zona",104.2,7],["juazeiro",104.2,7],["lindo",101.0,10],["mina",96.3,9],["janeiro",91.5,14],["luis",89.5,7],["juiz",89.5,7],["energia",80.9,13],["petrolina",74.4,5],["baiano",74.4,5],["grande",70.4,19],["p